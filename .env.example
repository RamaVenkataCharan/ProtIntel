# ==============================================================================
# ProtIntel Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# 1. API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DEVICE=cpu                     # Use 'cpu' or 'cuda' (for GPU acceleration)

# 2. Model Configuration
# Path to the pruned model weights checkpoint
MODEL_PATH=models/best_checkpoint_pruned.pt

# 3. Redis Caching & Job State Backend
# If configured, multi-worker uvicorn deployment is supported.
# If empty, the backend falls back to single-worker in-memory state.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Alternatively, specify a full connection URI:
# REDIS_URL=redis://localhost:6379/0

# 4. Security Configuration
# Comma-separated list of allowed origins. Do not use wildcards in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
